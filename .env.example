DATABASE_PATH=./data/medicine.db
HOUSEHOLD_TIMEZONE=America/New_York
KIOSK_RETURN_DELAY=1800
PORT=3001
LOG_LEVEL=info
# Optional: supply 32+ random characters. Otherwise generated once in the data volume.
SESSION_SECRET=
# Use true behind HTTPS. localhost development uses false.
COOKIE_SECURE=false

# Web Push contact URL or mailto address; set to the operator's contact in production.
PUSH_SUBJECT=https://pebbledose.local
